# --- Discord (https://discord.com/developers/applications) ---
# Bot token: Application -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID: General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional while developing: register slash commands to ONE server so they appear instantly.
# Leave blank for global registration (can take up to an hour to propagate).
DISCORD_GUILD_ID=

# --- Google Sheets write-back (optional) ---
# Only needed if pilots should be able to reserve, release and complete flights from Discord and have
# a linked Google Sheet follow. Path to a Google service account key (JSON). Keep that file out of
# any shared folder; anyone holding it can edit every sheet shared with the account.
# Setup steps: docs/WRITEBACK_SETUP.md. Leave blank and the bot only ever reads sheets.
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- FsHub (optional) ---
# A personal access token from https://fshub.io/settings/integrations. With it the bot checks the FsHub pilot
# IDs people type (and shows the name FsHub has for each) and `/setup fshub` can read your airline's roster to
# match pilots to their Discord accounts. Read-only; the token acts as your FsHub account, so keep it private.
# FsHub only shows an airline's roster to its members. Leave blank and the bot never contacts FsHub.
FSHUB_TOKEN=

# --- Bot behaviour ---
DATABASE_PATH=data/bot.sqlite
# debug | info | warn | error
LOG_LEVEL=info
